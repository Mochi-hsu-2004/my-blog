---
import  MainLayout  from "../layouts/MainLayout.astro";
---
<MainLayout title="PurpleSpace | Home">
	<section class="hero section-container">
<div class="hero-content">

  <div class="welcome-badge">
    ✨ Welcome to PurpleSpace
  </div>

  <h1>
    Discover a New
    <span class="gradient-text">
      Digital Experience.
    </span>
  </h1>

  <p class="hero-description">
    Explore our modern website with beautiful design,
    creative ideas and amazing digital experiences.
    Discover something extraordinary with us.
  </p>

  <div class="hero-buttons">
    <a href="/about" class="btn btn-primary">
      Explore More <span>→</span>
    </a>

    <a href="/contact" class="btn btn-glass">
      Contact Us
    </a>
  </div>

  <div class="hero-stats">
    <div>
      <h3>100%</h3>
      <p>Modern Design</p>
    </div>

    <div>
      <h3>24/7</h3>
      <p>Digital Experience</p>
    </div>

    <div>
      <h3>∞</h3>
      <p>Creative Ideas</p>
    </div>
  </div>

</div>

<div class="hero-visual">

  <div class="dashboard glass">

    <div class="dashboard-top">
      <div class="window-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <span class="dashboard-label">
        PurpleSpace Studio
      </span>
    </div>

    <div class="dashboard-main">
      <div class="dashboard-icon">✦</div>

      <h2>Design Beyond Limits</h2>

      <p>
        Build your imagination into
        beautiful digital experiences.
      </p>

      <div class="progress-title">
        <span>Creative Progress</span>
        <span>85%</span>
      </div>

      <div class="progress-bar">
        <div></div>
      </div>

      <div class="dashboard-bottom">
        <div>
          <span>Design</span>
          <strong>Modern</strong>
        </div>

        <div>
          <span>Experience</span>
          <strong>Premium</strong>
        </div>
      </div>
    </div>

  </div>

  <div class="floating-label floating-one glass">
    💜 Creative Design
  </div>

  <div class="floating-label floating-two glass">
    ⚡️ Modern Experience
  </div>

</div>
</section>

<section class="features section-container">
<div class="section-heading">
  <span class="section-tag">WHAT WE OFFER</span>

  <h2>
    Explore Our <span class="gradient-text">Features</span>
  </h2>

  <p>
    Everything you need for a better digital experience.
  </p>
</div>

<div class="feature-grid">

  <article class="feature-card glass">
    <div class="feature-icon">💎</div>
    <h3>Modern Design</h3>
    <p>
      Beautiful glassmorphism interface
      with elegant purple gradients.
    </p>
    <a href="/about">Learn More →</a>
  </article>

  <article class="feature-card glass">
    <div class="feature-icon">⚡️</div>
    <h3>Fast Performance</h3>
    <p>
      Smooth navigation and a fast
      browsing experience.
    </p>
    <a href="/about">Learn More →</a>
  </article>

  <article class="feature-card glass">
    <div class="feature-icon">📱</div>
    <h3>Responsive Design</h3>
    <p>
      Designed for desktop, tablet
      and mobile devices.
    </p>
    <a href="/about">Learn More →</a>
  </article>

</div>
</section>

<section class="cta-section section-container">
    <div class="cta-box glass">
      <span class="section-tag">LET'S CONNECT</span>

	  <h2>
    Ready to Explore Something
    <span class="gradient-text">New?</span>
  </h2>

  <p>
    Start your digital journey with PurpleSpace.
  </p>

  <a href="/contact" class="btn btn-primary">
    Get In Touch →
  </a>
</div>
</section>
</MainLayout>
