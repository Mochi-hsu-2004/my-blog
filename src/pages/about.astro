---
import MainLayout from "../layouts/MainLayout.astro";
---
<MainLayout title="PurpleSpace | About">
    <section class="inner-page section-container">
        <div class="welcome-badge">
  ✨ Get To Know Us
</div>

<h1>
  About <span class="gradient-text">PurpleSpace.</span>
</h1>

<p class="inner-description">
  PurpleSpace is a creative digital space focused on
  modern design, innovative ideas and beautiful
  user experiences.
</p>

<div class="about-grid">

  <div class="about-card glass">
    <div class="feature-icon">🎯</div>
    <h2>Our Mission</h2>
    <p>
      Our mission is to create simple, beautiful and
      meaningful digital experiences for everyone.
    </p>
  </div>

  <div class="about-card glass">
    <div class="feature-icon">🔮</div>
    <h2>Our Vision</h2>
    <p>
      We believe in creativity, modern technology
      and building a better digital future.
    </p>
  </div>

  <div class="about-card glass">
    <div class="feature-icon">💜</div>
    <h2>Our Values</h2>
    <p>
      Creativity, simplicity, innovation and
      user-friendly design are our core values.
    </p>
  </div>

</div>

<a href="/contact" class="btn btn-primary about-button">
  Contact Our Team →
</a>
    </section>
</MainLayout>