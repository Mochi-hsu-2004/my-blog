---
const currentPath=Astro.url.pathname;
---
<a href="/" class="brand">
  Purple<span>Space.</span>
</a>

<div class="nav-links">
  <a href="/" class:list={{ active: currentPath === "/" }}>
    Home
  </a>

  <a href="/about" class:list={{ active: currentPath === "/about" }}>
    About
  </a>

  <a href="/contact" class:list={{ active: currentPath === "/contact" }}>
    Contact
  </a>

  <a href="/login" class="nav-login">
    Login <span>↗️</span>
  </a>
</div>
